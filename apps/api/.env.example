# API Environment Variables
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000

# MySQL Database (Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/edda_db"

# Optional Redis (App runs normally without Redis)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET="edda_dev_access_jwt_super_secret_replace_in_production_min_32_chars!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="edda_dev_refresh_jwt_super_secret_replace_in_production_min_32_chars!"
JWT_REFRESH_EXPIRATION="7d"

# Security & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
OTP_RATE_LIMIT_PER_HOUR=5
OTP_EXPIRATION_SECONDS=300
BCRYPT_SALT_ROUNDS=12
OTP_PEPPER="dev_otp_pepper_secret_min_32_characters_long!"
NATIONAL_ID_ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
NATIONAL_ID_HMAC_KEY="dev_national_id_hmac_secret_min_32_characters_long!"

# SMS Provider (development | twilio | unifonic | vodafone)
SMS_PROVIDER=development

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT="./uploads"
STORAGE_MAX_FILE_SIZE_MB=10

# Payment Provider
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET="edda_webhook_secret_for_local_signature_verification"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
