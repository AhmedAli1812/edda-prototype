# ==============================================================================
# Edda Marketplace - Master Environment Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and configure values before starting services.
# Never commit real credentials or private keys to source control.

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# MySQL Database (Prisma)
# ------------------------------------------------------------------------------
# Local development (Docker MySQL or local MySQL 8):
DATABASE_URL="mysql://root:password@localhost:3306/edda_db"

# Production Hostinger example (with SSL when required):
# DATABASE_URL="mysql://u123456789_edda:SecurePassword@127.0.0.1:3306/u123456789_edda?sslaccept=strict"

# ------------------------------------------------------------------------------
# Redis (Optional - Application runs fully without Redis)
# ------------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# JWT Authentication & Token Security
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="edda_dev_access_jwt_super_secret_replace_in_production_min_32_chars!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="edda_dev_refresh_jwt_super_secret_replace_in_production_min_32_chars!"
JWT_REFRESH_EXPIRATION="7d"

# ------------------------------------------------------------------------------
# Throttling & Rate Limiting
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
OTP_RATE_LIMIT_PER_HOUR=5
OTP_EXPIRATION_SECONDS=300

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
# Set to 'false' to disable OTP endpoints and run with phone + password authentication.
# When OTP_ENABLED=false, SMS_PROVIDER and SMS credentials are NOT required.
# When OTP_ENABLED=true, a valid SMS provider (e.g. cequens) and credentials are required in production.
OTP_ENABLED=false

# ------------------------------------------------------------------------------
# SMS Gateway (development | cequens | twilio) - Required ONLY when OTP_ENABLED=true
# ------------------------------------------------------------------------------
# In production, SMS_PROVIDER cannot be 'development'.
# When OTP_ENABLED=false, SMS_PROVIDER and provider credentials below are ignored/optional.
SMS_PROVIDER=development

# Cequens Provider Configuration (required when OTP_ENABLED=true and SMS_PROVIDER=cequens)
CEQUENS_USERNAME=""
CEQUENS_API_KEY=""
CEQUENS_SENDER_NAME=""

# Twilio Provider Configuration (required when OTP_ENABLED=true and SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# ------------------------------------------------------------------------------
# Storage Abstraction (Service photos, KYC docs, Products, Invoices)
# ------------------------------------------------------------------------------
# Options: 'local' (development / Hostinger shared disk) | 's3' (production AWS/Wasabi)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT="./uploads"
STORAGE_MAX_FILE_SIZE_MB=10

# S3 Configuration (Used if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="me-south-1"
AWS_S3_BUCKET_NAME="edda-marketplace-assets"
AWS_S3_ENDPOINT=""

# ------------------------------------------------------------------------------
# Payment Gateway (Provider-Agnostic Interface)
# ------------------------------------------------------------------------------
# Options: 'mock' | 'paymob' | 'fawry' | 'kashier'
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET="edda_webhook_secret_for_local_signature_verification"

# ------------------------------------------------------------------------------
# Push Notifications (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# CORS Configuration (Comma-separated origins)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://admin.edda.eg"
